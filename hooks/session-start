#!/usr/bin/env bash
# SessionStart hook for superpowers plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Resolve workspace raw dirs. Prints "specs<TAB>plans" on success, or a line
# starting with ERR: on failure. Runs in the session cwd so discovery works.
RESOLVED=$(uv run --project "$PLUGIN_ROOT" python -c '
import sys
from pathlib import Path
try:
    from workspace_io import config, paths
    ws = config.resolve(Path.cwd()).workspace
    sys.stdout.write(str(paths.raw_dir(ws)))
    try:
        import hashlib, json as _json
        gw_dir = paths.graph_dir(ws)
        cfg_file = gw_dir / "config.json"
        info = {"routing": None, "commit_strategy": None, "stale": False, "legacy": []}
        if cfg_file.exists():
            cfg = _json.loads(cfg_file.read_text(encoding="utf-8"))
            wf = cfg.get("workflow") or {}
            routing = wf.get("model_routing") or {}
            if isinstance(routing, dict) and routing:
                info["routing"] = routing
            info["commit_strategy"] = wf.get("commit_strategy")
            info["effort_map"] = wf.get("effort_map")
            info["enforce_effort"] = wf.get("enforce_effort")
            mpath = paths.manifest_path(ws)
            embedded = (cfg.get("_meta") or {}).get("manifest_sha256")
            if mpath.exists() and embedded:
                actual = hashlib.sha256(mpath.read_bytes()).hexdigest()
                info["stale"] = actual != embedded
        for legacy in ("model-routing.json", "workflow.json"):
            if (gw_dir / legacy).exists():
                info["legacy"].append(legacy)
        sys.stdout.write("\n<<<GRAPHWORKS_CONFIG>>>\n")
        sys.stdout.write(_json.dumps(info))
    except Exception:
        pass  # fail-open: notices are optional
    try:
        from work_io.sidecar import load_sidecar
        from work_io.resume import format_resume_suggestion, select_resume_suggestions
        suggestion = select_resume_suggestions(load_sidecar(paths.wiki_dir(ws)))
        if suggestion is not None:
            sys.stdout.write("\n<<<GRAPHWORKS_RESUME>>>\n")
            sys.stdout.write(format_resume_suggestion(suggestion))
    except Exception:
        pass  # fail-open: no suggestion, raw dir already emitted
except Exception as e:
    sys.stdout.write("ERR:" + str(e).replace("\n", " "))
' 2>/dev/null) || RESOLVED="ERR:uv-invocation-failed"

# The python block may append a config-notice line and a resume suggestion,
# each after its own unique delimiter (config emitted first, then resume).
# Split each off so $RESOLVED stays the raw-dir-only value the notices below
# use. ORDER MATTERS: the resume split MUST run before the config split.
# The resume block is the LAST segment of the stream, so splitting it off
# first leaves $RESOLVED ending at the config JSON. If the config split ran
# first, its ${RESOLVED#...} would capture the config JSON PLUS the resume
# delimiter and text into $config_info (and its ${RESOLVED%%...} would
# truncate $RESOLVED before the resume delimiter, losing the suggestion) —
# and a resume suggestion mentioning workflow.json or '"stale": true' would
# then false-positive the legacy/stale notices below.
resume_message=""
# resume_display holds the same suggestion WITHOUT the leading blank lines, for
# the user-facing systemMessage channel (additionalContext gets resume_message).
resume_display=""
case "$RESOLVED" in
  *"<<<GRAPHWORKS_RESUME>>>"*)
    resume_text="${RESOLVED#*<<<GRAPHWORKS_RESUME>>>$'\n'}"
    RESOLVED="${RESOLVED%%$'\n'<<<GRAPHWORKS_RESUME>>>*}"
    if [ -n "$resume_text" ]; then
      resume_message=$'\n\n'"$resume_text"
      resume_display="$resume_text"
    fi
    ;;
esac

config_info=""
case "$RESOLVED" in
  *"<<<GRAPHWORKS_CONFIG>>>"*)
    config_info="${RESOLVED#*<<<GRAPHWORKS_CONFIG>>>$'\n'}"
    RESOLVED="${RESOLVED%%$'\n'<<<GRAPHWORKS_CONFIG>>>*}"
    ;;
esac

# Model routing / commit-strategy / staleness / legacy-file notices — all
# derived from <root>/state/config.json (the manifest projection),
# read by the python block above and passed here via $config_info. That JSON
# is built entirely from values the python block constructed itself (the
# routing mapping is re-serialized JSON), so it is control-character-free by
# construction and needs no sanitization pass before embedding.
config_get() { printf '%s' "$config_info" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"; }

routing_message=""
routing_mapping=$(printf '%s' "$config_info" | sed -n 's/.*"routing"[[:space:]]*:[[:space:]]*\({[^}]*}\).*/\1/p')
if [ -n "$routing_mapping" ]; then
    routing_message="\n\n<model-routing-active>This project routes plan-execution subagents to cheaper models. Mapping (<root>/state/config.json, from the manifest's workflow.model_routing): ${routing_mapping}. Plan-time: every plan task's json:metadata fence MUST carry \"modelTier\" — \"mechanical\" (1-2 files, complete spec with code in the steps, no design judgment; most tasks in a well-specified plan), \"standard\" (multi-file integration, pattern matching, debugging), or \"frontier\" (design/architecture judgment). Tie-break: spec completeness wins. Dispatch-time: pass the Agent model parameter resolved from the in-progress task's tier via the mapping (\"inherit\" = omit the parameter); spec and code-quality reviewers use the \"standard\" tier's model; the final whole-plan reviewer (after all tasks complete) stays at session level — omit the model parameter. A task metadata \"model\" pin overrides its tier. This notice is the only delivery mechanism — no enforcement gate backs it; comply at plan-writing and dispatch time. Configure: gw config set workflow.model_routing.<tier> <model>.</model-routing-active>"
fi

# Per-tier thinking-effort map. Unlike upstream, this is NOT implicit: the
# notice is emitted only when the manifest actually sets workflow.effort_map,
# so an unconfigured workspace gets byte-identical output to a build without
# this feature at all. workflow.enforce_effort (also absent by default) only
# changes the wording of what's emitted, never whether it's emitted.
effort_map=$(printf '%s' "$config_info" | sed -n 's/.*"effort_map"[[:space:]]*:[[:space:]]*\({[^}]*}\).*/\1/p')
if [ -n "$routing_message" ] && [ -n "$effort_map" ]; then
    case "$config_info" in
      *'"enforce_effort": true'*|*'"enforce_effort":true'*)
        effort_enforcement="ENFORCED: the dispatch gate resolves the effort your subagent_type pins (agent-definition frontmatter \`effort:\`) and blocks a dispatch that does not match the tier's effort. The Agent tool has no effort parameter, so route through an effort-pinned agent type. Any agent definition carrying an \`effort:\` key works." ;;
      *)
        effort_enforcement="Advisory only; no gate enforces effort unless the workspace manifest sets workflow.enforce_effort: true." ;;
    esac
    routing_message="${routing_message} <effort-routing-active>Per-tier thinking effort for routed dispatches. Effort map (<root>/state/config.json, from the manifest's workflow.effort_map): ${effort_map} (\"inherit\" = session effort). Apply it wherever effort is controllable: Workflow agent() calls take a per-dispatch effort option; custom agent definitions can pin effort in frontmatter; the plain Agent tool has no effort parameter, so prefer effort-pinned agent types for routed-down dispatches. Capability and thinking effort are independent dials — raising effort on a routed-down model does not recover capability, so when a task outgrows its tier at the mapped effort, escalate the TIER (model), never the effort. ${effort_enforcement}</effort-routing-active>"
fi

workflow_message=""
if [ "$(config_get commit_strategy)" = "at-end" ]; then
    workflow_message="\n\n<workflow-config-active>This project sets workflow.commit_strategy: at-end (<root>/state/config.json): one commit per plan, not per task. Plan-time: OMIT the per-task Commit step from every task's Steps; instead add ONE final task — 'Commit the full implementation' — at the end of the plan, blockedBy ALL implementation tasks, whose steps stage and commit the entire change set as a single commit. Dispatch-time: tell implementer subagents NOT to commit (replace the 'Commit your work' instruction with: do not commit; leave all changes in the working tree — the coordinator's final task makes the single commit). Reviewers review the uncommitted working-tree diff instead of per-task commit SHAs. This notice is the only delivery mechanism — no enforcement gate backs it; comply at plan-writing and dispatch time. Default (per-task commits) resumes via: gw config unset workflow.commit_strategy.</workflow-config-active>"
fi

stale_message=""
case "$config_info" in *'"stale": true'*|*'"stale":true'*)
    stale_message="\n\n<graph-works-config-stale>The workspace manifest (workspace.yaml) has changed since <root>/state/config.json was generated (hash mismatch — likely a hand-edit). Hooks read the projection, so it is out of date. Run: gw config sync</graph-works-config-stale>" ;;
esac

legacy_message=""
case "$config_info" in *model-routing.json*|*workflow.json*)
    legacy_message="\n\n<graph-works-legacy-config>Legacy onboard config files found in <root>/state/ (model-routing.json / workflow.json). They are ignored — configuration now lives in the workspace manifest via gw config. Re-run gw config init (or /graph-works:config-init) to migrate your choices, then delete the legacy files.</graph-works-legacy-config>" ;;
esac

# Read the workflow-bootstrap skill. It lives at upstream's own path -- see PATCHES.md entry #7 --
# so that upstream edits to it arrive as a merge rather than being silently dropped.
using_workflow_content=$(cat "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_workflow_escaped=$(escape_for_json "$using_workflow_content")
routing_escaped=$(escape_for_json "$routing_message")
workflow_escaped=$(escape_for_json "$workflow_message")
stale_escaped=$(escape_for_json "$stale_message")
legacy_escaped=$(escape_for_json "$legacy_message")
resume_escaped=$(escape_for_json "$resume_message")
resume_display_escaped=$(escape_for_json "$resume_display")
session_context="<EXTREMELY_IMPORTANT>\nYou have graph-works workflows.\n\n**Below is the full content of your 'graph-works:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_workflow_escaped}\n\n${routing_escaped}${workflow_escaped}${stale_escaped}${legacy_escaped}${resume_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI.
  # When an in-flight resume suggestion exists, ALSO emit it via systemMessage so
  # Claude Code renders it directly in the user's transcript. additionalContext
  # is model-only (invisible to the user) and relies on the model choosing to
  # surface it; systemMessage guarantees the suggestion is shown. Emitted only
  # when resume_display is non-empty so fresh sessions show no empty notice.
  if [ -n "$resume_display" ]; then
    printf '{\n  "systemMessage": "%s",\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$resume_display_escaped" "$session_context" | cat
  else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
  fi
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
